# {{ ansible_managed }}
# SWInv collector configuration. Read by swinv-collector.service (EnvironmentFile), mode 0600, root.
# systemd EnvironmentFile syntax: KEY=value, no export, no shell expansion, no quotes needed.
SWINV_WEBHOOK_URL={{ swinv_webhook_url }}
SWINV_TOKEN={{ swinv_token }}
SWINV_OUT_FILE={{ swinv_out_file }}

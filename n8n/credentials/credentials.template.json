[
  {
    "id": "swinvPostgres01",
    "name": "SWInv Postgres (inventory)",
    "type": "postgres",
    "data": {
      "host": "postgres",
      "port": 5432,
      "database": "__INVENTORY_DB__",
      "user": "__POSTGRES_USER__",
      "password": "__POSTGRES_PASSWORD__",
      "ssl": "disable",
      "allowUnauthorizedCerts": false,
      "sshTunnel": false
    }
  },
  {
    "id": "swinvOllama0001",
    "name": "SWInv Ollama (local GPU)",
    "type": "ollamaApi",
    "data": {
      "baseUrl": "__OLLAMA_BASE_URL__"
    }
  },
  {
    "id": "swinvWebhookTok",
    "name": "SWInv Collector Token (header X-Inventory-Token)",
    "type": "httpHeaderAuth",
    "data": {
      "name": "X-Inventory-Token",
      "value": "__INVENTORY_WEBHOOK_TOKEN__"
    }
  }
]

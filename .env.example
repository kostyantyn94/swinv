# ---- SWInv: Software Inventory & Classification (n8n + AI) ----
COMPOSE_PROJECT_NAME=swinv

# Postgres (n8n metadata DB + inventory DB live in the same instance, separate databases)
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n_local_secret
POSTGRES_DB=n8n
INVENTORY_DB=inventory

# n8n
N8N_ENCRYPTION_KEY=change-me-32-random-hex-chars
N8N_OWNER_EMAIL=admin@swinv.local
N8N_OWNER_PASSWORD=SwInv!2026demo
N8N_OWNER_FIRSTNAME=Kostiantyn
N8N_OWNER_LASTNAME=Karimov
GENERIC_TIMEZONE=Europe/Kyiv

# Collector -> n8n webhook shared secret (sent as X-Inventory-Token header)
INVENTORY_WEBHOOK_TOKEN=change-me-webhook-token

# LLM: local Ollama (GPU). To switch to OpenAI-compatible cloud, set OPENAI_API_KEY and swap the model sub-node in n8n.
OLLAMA_MODEL=qwen2.5:14b
# Ollama endpoint as seen from the n8n container. Docker service: http://ollama:11434 ; native Ollama on the host (macOS): http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434
OPENAI_API_KEY=

# GPU for Ollama (NVIDIA only). setup.ps1 / setup.sh set this automatically when an NVIDIA runtime is detected.
# COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
